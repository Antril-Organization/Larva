// Automatic signals. A `reactive` field is a Source: reading it inside an effect makes the effect depend on it, and
// assigning it runs those effects again. `effect { … }` runs now and whenever something it read changes, and gives the
// Effect (Dispose stops it). A `reacts` method of a class runs as an effect once its object is constructed.
// `Reactive.Batch(f)` gathers the changes `f` makes and runs each effect once at the end. An effect does not run again
// while it runs, so one that writes what it reads does not loop. A `computed` property is a Computed<T>: its value is
// kept until something it read changes (then it is stale, and whoever read it is notified); it is computed again only
// when it is read next. Each run of an effect starts from no dependencies: a Source it stops reading stops running it.

into namespace System.Reactive
{
	/// What effects depend on: tracked when read inside one, notifying its observers when written.
	public final class Source
	{
		static i64 made;

		/// Its observers in the order they began to observe; an effect that stops leaves a null slot (taken out together
		/// by Compact once they are half of them), so adding or removing one is a step, not a search.
		List<Effect?> observers = new List<Effect?>();
		/// For each slot, where this source is in its effect's list of sources.
		List<i32> backs = new List<i32>();
		i32 live;
		/// The effect, and which of its runs, that tracked it last: reading it again in that run is found at once.
		Effect? markEffect;
		i64 markRun;

		/// Takes out the null slots, keeping the order, and tells each effect that moves its new slot.
		Compact()
		{
			i32 kept = 0;
			loop (i32 i = 0..observers.Count)
			{
				if (observers[i] is Effect effect)
				{
					i32 back = backs[i];
					observers[kept] = effect;
					backs[kept] = back;
					effect.Moved(back, kept);
					kept++;
				}
			}
			loop (observers.Count > kept)
			{
				observers.Pop();
				backs.Pop();
			}
		}

		public:
			/// Makes the running effect (if any) an observer.
			Track()
			{
				if (Reactive.Current is Effect current)
				{
					if (markEffect == current && markRun == current.Runs)
						return;
					markEffect = current;
					markRun = current.Runs;
					if (current.Reads(this))
						return;
					backs.Add(current.Watching(this, observers.Count));
					observers.Add(current);
					live++;
				}
			}

			/// The number of effects it runs.
			i32 Observers { get => live; }

		/// Its number (Effect keeps the numbers of its sources in a set once it has many).
		internal i64 Id = NextId();

		static NextId() : i64
		{
			made++;
			return made;
		}

		/// The effect in `slot` no longer observes it.
		internal Unlink(i32 slot)
		{
			observers[slot] = null;
			live--;
			if (observers.Count >= 32 && live * 2 < observers.Count)
				Compact();
		}

			/// Runs every observer again (once each, at the end of a batch).
			Notify()
			{
				Effect?[] running = new Effect?[live];
				i32 count = 0;
				loop (i32 i = 0..observers.Count)
				{
					if (observers[i] is Effect effect)
					{
						running[count] = effect;
						count++;
					}
				}
				loop (i32 i = 0..count)
				{
					if (running[i] is Effect effect)
						Reactive.Schedule(effect);
				}
			}
	}

	/// A computation that runs again whenever a Source it read notifies, until disposed.
	public final class Effect
	{
		func<> : void body;
		bool running;
		bool disposed;
		List<Source> sources = new List<Source>();
		/// For each source, its slot in that source's observers.
		List<i32> slots = new List<i32>();
		/// The ids of `sources` once there are more than a few (below that a search of the list is quicker).
		HashSet<i64>? ids;

		internal bool Pending;
		/// Where it is in the batch's pending effects (while Pending).
		internal i32 PendingAt;
		/// How many times it let go of its sources: a Source's mark of one of its runs holds until then.
		internal i64 Runs;

		/// A lazy effect (a Computed's) does not run when notified: it goes stale, and tells `Dependents`.
		internal bool Lazy;
		internal bool Stale;
		internal Source? Dependents;

		/// Whether this run read `source` already.
		internal Reads(Source source) : bool
		{
			if (ids is HashSet<i64> known)
				return known.Contains(source.Id);
			loop (i32 i = 0..sources.Count)
			{
				if (sources[i] == source)
					return true;
			}
			return false;
		}

		/// `source` keeps it in `slot`: where the source is in its list.
		internal Watching(Source source, i32 slot) : i32
		{
			sources.Add(source);
			slots.Add(slot);
			if (ids is HashSet<i64> known)
				known.Add(source.Id);
			else if (sources.Count > 8)
			{
				HashSet<i64> all = new HashSet<i64>();
				loop (i32 i = 0..sources.Count)
					all.Add(sources[i].Id);
				ids = all;
			}
			return sources.Count - 1;
		}

		/// The source at `back` moved it to `slot`.
		internal Moved(i32 back, i32 slot)
		{
			slots[back] = slot;
		}

		Release()
		{
			loop (i32 i = 0..sources.Count)
				sources[i].Unlink(slots[i]);
			sources.Clear();
			slots.Clear();
			ids = null;
			Runs++;
		}

		public:
			new(func<> : void body)
			{
				this.body = body;
			}

			/// Runs the computation, tracking what it reads (not while it already runs, nor once disposed). It starts
			/// from no dependencies: only what this run reads keeps running it.
			Run()
			{
				if (running || disposed)
					return;
				running = true;
				Release();
				Effect? previous = Reactive.Current;
				Reactive.Current = this;
				try
				{
					body();
				}
				finally
				{
					// Whatever the body does (even throw), the effect can run again and the one that was running
					// is current again; the error goes on to whoever assigned the reactive value.
					Reactive.Current = previous;
					running = false;
					Stale = false;
				}
			}

			/// What a change does to it: runs it, or (lazy) marks it stale once and notifies what depends on it.
			Trigger()
			{
				if (!Lazy)
				{
					Run();
					return;
				}
				if (Stale || disposed)
					return;
				Stale = true;
				if (Dependents is Source dependents)
					dependents.Notify();
			}

			/// Stops it: it never runs again, and no Source keeps it.
			Dispose()
			{
				disposed = true;
				Release();
			}

			/// How many sources its last run read.
			i32 Sources { get => sources.Count; }

			bool Disposed { get => disposed; }
	}

	/// A value computed from reactive ones, kept until one of them changes: what `computed T P => e;` makes.
	public final class Computed<T>
	{
		func<> : T compute;
		T value;
		Source source = new Source();
		Effect tracker;

		Refresh()
		{
			value = compute();
		}

		public:
			new(func<> : T compute)
			{
				this.compute = compute;
				tracker = new Effect(Refresh);
				tracker.Lazy = true;
				tracker.Stale = true;
				tracker.Dependents = source;
			}

			/// The value (computed now when stale); reading it inside an effect makes the effect depend on it.
			T Value
			{
				get
				{
					source.Track();
					if (tracker.Stale || tracker.Pending)
						Reactive.Refresh(tracker);
					return value;
				}
			}

			/// Whether the next read computes it again.
			bool Stale { get => tracker.Stale; }

			/// Stops tracking: it keeps its last value and no Source invalidates it again.
			Dispose()
			{
				tracker.Dispose();
			}
	}

	public static class Reactive
	{
		static i32 depth;
		static List<Effect?> pending = new List<Effect?>();

		public:
			/// The effect running now (what a Source being read should track), or null.
			static Effect? Current;

			/// Runs `body` now, and again whenever a reactive value it read changes.
			static Watch(func<> : void body) : Effect
			{
				Effect effect = new Effect(body);
				effect.Run();
				return effect;
			}

			/// Runs `body`; the effects its changes trigger run once each when it is done.
			static Batch(func<> : void body)
			{
				depth++;
				try
				{
					body();
				}
				finally
				{
					// Even when the body throws: the batch ends, and the effects its changes scheduled run once.
					depth--;
					if (depth == 0)
						Flush();
				}
			}

			/// Runs an effect now, or once at the end of the batch in progress.
			static Schedule(Effect effect)
			{
				if (depth == 0)
				{
					effect.Trigger();
					return;
				}
				if (!effect.Pending)
				{
					effect.Pending = true;
					effect.PendingAt = pending.Count;
					pending.Add(effect);
				}
			}

		/// Computes a lazy effect now, also inside a batch: a read of a computed sees the current values, not what it
		/// kept before the batch changed something it depends on. One scheduled in the batch is done with (it does
		/// not go stale again when the batch ends).
		internal static Refresh(Effect tracker)
		{
			if (tracker.Pending)
			{
				tracker.Pending = false;
				// Its slot in the batch's list is emptied (Flush passes over it); one being flushed is not in that list.
				i32 at = tracker.PendingAt;
				if (at < pending.Count && pending[at] == tracker)
					pending[at] = null;
				tracker.Trigger();
			}
			if (tracker.Stale)
				tracker.Run();
		}

		static Flush()
		{
			List<Effect?> due = pending;
			pending = new List<Effect?>();
			loop (i32 i = 0..due.Count)
			{
				if (due[i] is Effect effect)
				{
					effect.Pending = false;
					effect.Trigger();
				}
			}
		}
	}
}
