				return (u64)bits ^ (u64)(bits >> 64) ^ (u64)(bits >> 128) ^ (u64)(bits >> 192);
			}

			/// The IEEE 754 bits of the number, and back.
			static unsafe Bits(f256 value) : u256
			{
				f256 local = value;
				return *(u256*)&local;
			}

			static unsafe FromBits(u256 bits) : f256
			{
				u256 local = bits;
				return *(f256*)&local;
			}

			static IsNaN(f256 x) : bool => x != x;
			static IsInfinity(f256 x) : bool => x - x != 0 && x == x;
			static IsFinite(f256 x) : bool => x - x == 0;

			/// The number `text` writes (digits, a point, an exponent); a FormatError otherwise.
			static Parse(str text) : f256
			{
				str trimmed = text.Trim();
				if (trimmed == "NaN")
					return NaN;
				if (trimmed == "Infinity" || trimmed == "+Infinity")
					return PositiveInfinity;
				if (trimmed == "-Infinity")
					return NegativeInfinity;
				if (!Float64.IsNumber(trimmed.Units()))
					throw new FormatError("not a number: " + text);
				return Read(trimmed.Units());
