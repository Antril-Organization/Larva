			[Inline] static ToF64(f16 value) : f64 => (f64)value;
			static f16 NegativeOne { get => -1; }

			/// As text by a format: F, N, E, P, G, R and a precision (`(2.5f16).ToString("F2")` is "2.50").
			ToString(str format) : str => NumberFormat.FormatHalf(this, format);

			/// The shortest text that reads back as the same number.
			ToString() : str => NumberFormat.FormatHalf(this, "G");
			CompareTo(f16 other) : i32 => this < other ? -1 : this > other ? 1 : 0;
			Equals(f16 other) : bool => this == other || IsNaN(this) && IsNaN(other);
			Hash() : u64 => (u64)Bits(this == 0 ? 0 : this);

			/// The IEEE 754 bits of the number, and back.
			static unsafe Bits(f16 value) : u16
			{
				f16 local = value;
				return *(u16*)&local;
			}

			static unsafe FromBits(u16 bits) : f16
			{
				u16 local = bits;
				return *(f16*)&local;
			}

			static IsNaN(f16 x) : bool => x != x;
			static IsInfinity(f16 x) : bool => x - x != 0 && x == x;
			static IsFinite(f16 x) : bool => x - x == 0;

