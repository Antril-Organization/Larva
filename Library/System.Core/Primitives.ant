			ToString() : str => NumberFormat.FormatWide(Bits(this), 256, "G");
			CompareTo(f256 other) : i32 => this < other ? -1 : this > other ? 1 : 0;
			Equals(f256 other) : bool => this == other || IsNaN(this) && IsNaN(other);

