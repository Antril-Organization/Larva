// The members of the primitive types: `i32` and `System.Int32` are one type; these declarations give it its members and
// interfaces (methods take `this` as the value itself).

into namespace System
{
	[Primitive("i32")]
	public value Int32 : ISignedNumber<i32>, IHashable<i32>, IComparable<i32>, IToString
	{
		public:
			static i32 Zero { get => 0; }
			static i32 One { get => 1; }
			/// The smallest i32.
			const i32 MinValue = -2147483647 - 1;
			/// The largest i32.
			const i32 MaxValue = 2147483647;
			[Inline] static FromF64(f64 value) : i32 => (i32)value;
			[Inline] static ToF64(i32 value) : f64 => (f64)value;
			static i32 NegativeOne { get => -1; }

			/// As text by a format: D, X, B, N, F, E, P, G and a precision (`255.ToString("X4")` is "00FF").
			ToString(str format) : str => NumberFormat.FormatInteger((u64)(u32)this, 32, true, format);

			ToString() : str => Number.Format(this);
			Hash() : u64 => (u64)(u32)this;
			Equals(i32 other) : bool => this == other;
			CompareTo(i32 other) : i32 => this < other ? -1 : this > other ? 1 : 0;
			static Parse(str text) : i32 => (i32)Number.Parse(text);

			/// The number `text` writes, or null when it writes none.
			static TryParse(str text) : i32?
			{
				i64? value = Number.TryParse(text);
				if (value == null)
					return null;
				return (i32)value.Value;
			}
	}

