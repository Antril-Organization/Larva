			/// The number `text` writes, or null when it writes none.
			static TryParse(str text) : f256?
			{
				str trimmed = text.Trim();
				if (trimmed == "NaN" || trimmed == "Infinity" || trimmed == "+Infinity" || trimmed == "-Infinity")
					return Parse(trimmed);
				if (!Float64.IsNumber(trimmed.Units()))
					return null;
				return Read(trimmed.Units());
			}

		/// Digits × 10^exponent: exact (one correctly rounded operation) up to 71 significant digits and a power
		/// of ten up to 10^102, which the type holds exactly; beyond that, within a few units in the last place.
		static Read(u8[] units) : f256
		{
			i32 i = 0;
			bool negative = units[0] == '-';
			if (negative || units[0] == '+')
				i++;
			u256 digits = 0;
			i32 count = 0;
			i32 exponent = 0;
			bool afterPoint = false;
			loop (i < units.Length)
			{
				u8 c = units[i];
				i++;
				if (c == '.')
				{
					afterPoint = true;
					continue;
				}
				if (c == 'e' || c == 'E')
				{
					bool negativeExponent = units[i] == '-';
					if (negativeExponent || units[i] == '+')
						i++;
					i32 e = 0;
					loop (i < units.Length)
					{
						if (e < 1000000)
							e = e * 10 + (i32)(units[i] - 48);
						i++;
					}
					exponent += negativeExponent ? -e : e;
					break;
				}
				i32 d = (i32)(c - 48);
				if (digits == 0 && d == 0)
				{
					if (afterPoint)
						exponent--;
					continue;
				}
				if (count < 71)
				{
					digits = digits * 10 + (u256)d;
					count++;
					if (afterPoint)
						exponent--;
				}
				else if (!afterPoint)
				{
					exponent++;
				}
			}
			f256 value = (f256)digits;
			loop (exponent > 0)
			{
				i32 step = exponent > 70000 ? 70000 : exponent;
				value = value * PowerOfTen(step);
				exponent -= step;
			}
			loop (exponent < 0)
			{
				i32 step = -exponent > 70000 ? 70000 : -exponent;
				value = value / PowerOfTen(step);
				exponent += step;
			}
			return negative ? -value : value;
		}

		/// 10^power by squaring (exact up to 10^102).
		static PowerOfTen(i32 power) : f256
		{
			f256 result = 1;
			f256 base = 10;
			loop (power > 0)
			{
				if ((power & 1) != 0)
					result = result * base;
				base = base * base;
				power = power >> 1;
			}
			return result;
		}
	}

	[Primitive("bool")]
	public value Boolean : IHashable<bool>, IToString
	{
		public:
			ToString() : str => this ? "true" : "false";
			Hash() : u64 => this ? 1 : 0;
			Equals(bool other) : bool => this == other;
	}

	/// Numbers as text and back.
	public static class Number
	{
		public:
			/// The decimal digits of `value` (with a '-' when negative).
			Format(i64 value) : str
			{
				if (value >= 0)
					return FormatUnsigned((u64)value);
				// -(value + 1) + 1 keeps the smallest i64 in range.
				u64 magnitude = (u64)(-(value + 1)) + 1;
				return String<u8>.Decimal(magnitude, true);
			}

			/// The decimal digits of `value`.
			FormatUnsigned(u64 value) : str
			{
				return String<u8>.Decimal(value, false);
			}

			/// The decimal digits of a 128-bit `value`.
			FormatUnsigned(u128 value) : str
			{
				i32 count = 1;
				u128 rest = value;
				loop (rest >= 10)
				{
					rest = rest / 10;
					count++;
				}
				u8[] digits = new u8[count];
				i32 at = count;
				do
				{
					at--;
					digits[at] = (u8)(48 + (u64)(value % 10));
					value = value / 10;
				}
				loop (value > 0);
				return new String<u8>(digits);
			}

			/// The decimal digits of a 256-bit `value`.
			FormatUnsigned(u256 value) : str
			{
				i32 count = 1;
				u256 rest = value;
				loop (rest >= 10)
				{
					rest = rest / 10;
					count++;
				}
				u8[] digits = new u8[count];
				i32 at = count;
				do
				{
					at--;
					digits[at] = (u8)(48 + (u64)(value % 10));
					value = value / 10;
				}
				loop (value > 0);
				return new String<u8>(digits);
			}

			/// How many decimal digits `value` has (1 for 0).
			DigitCount(u64 value) : i32
			{
				i32 count = 1;
				loop (value >= 10)
				{
					value = value / 10;
					count++;
				}
				return count;
			}

			/// Writes the digits of `value` so they end just before `end`.
			WriteDigits(u64 value, u8[] units, i32 end)
			{
				i32 at = end;
				do
				{
					at--;
					units[at] = (u8)(48 + value % 10);
					value = value / 10;
				}
				loop (value > 0);
			}

			/// The integer `text` writes (an optional '-', then decimal digits); a FormatError otherwise.
			Parse(str text) : i64
			{
				i64? value = TryParse(text);
				if (value == null)
					throw new FormatError("not a number: " + text);
				return value.Value;
			}

			/// The integer `text` writes (an optional '-', then decimal digits), or null.
			TryParse(str text) : i64?
			{
				i32 length = text.Length;
				bool negative = length > 0 && text[0] == 45;
				i32 start = negative ? 1 : 0;
				if (start == length)
					return null;
				i64 value = 0;
				loop (i32 i = start..length)
				{
					u8 unit = text[i];
					if (unit < 48 || unit > 57)
						return null;
					value = value * 10 + (i64)(unit - 48);
				}
				return negative ? -value : value;
			}

	}
}
