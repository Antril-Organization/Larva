			static Parse(str text) : f16 => (f16)Float64.Parse(text);

			/// The number `text` writes, or null when it writes none.
			static TryParse(str text) : f16?
			{
				f64? value = Float64.TryParse(text);
				if (value == null)
					return null;
				return (f16)value.Value;
			}
	}

