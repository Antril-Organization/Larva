	[Primitive("f64")]
	public value Float64 : ISignedNumber<f64>, IHashable<f64>, IComparable<f64>, IToString
	{
		public:
			static f64 Zero { get => 0.0; }
			static f64 One { get => 1.0; }
			/// The largest finite f64, and the smallest (its negative).
			const f64 MaxValue = 1.7976931348623157e308;
			const f64 MinValue = -1.7976931348623157e308;
			/// The smallest f64 above zero (a subnormal).
			const f64 Epsilon = 4.9406564584124654e-324;
			/// Not a number (quiet, positive), and the infinities.
			const f64 NaN = 0.0 / 0.0;
			const f64 PositiveInfinity = 1.0 / 0.0;
			const f64 NegativeInfinity = -1.0 / 0.0;
			[Inline] static FromF64(f64 value) : f64 => value;
			[Inline] static ToF64(f64 value) : f64 => value;
			static f64 NegativeOne { get => -1.0; }

		extern("format.f64") FormatInto(f64 value) : i64;
		extern("format.unit") FormattedUnit(i64 index) : i64;
		extern("parse.f64") ParseBits(u16[] text) : i64;
		extern("f64.bits") BitsOf(f64 value) : i64;
		extern("f64.from_bits") FromBitsOf(i64 bits) : f64;

		/// Digits, an optional point and more digits, an optional exponent: what ParseBits reads.
		static IsNumber(u8[] text) : bool
		{
			i32 i = 0;
			i32 n = text.Length;
			if (i < n && (text[i] == '-' || text[i] == '+'))
				i++;
			i32 digits = 0;
			loop (i < n && text[i] >= '0' && text[i] <= '9')
			{
				i++;
				digits++;
			}
			if (i < n && text[i] == '.')
			{
				i++;
				loop (i < n && text[i] >= '0' && text[i] <= '9')
				{
					i++;
					digits++;
				}
			}
			if (digits == 0)
				return false;
			if (i < n && (text[i] == 'e' || text[i] == 'E'))
			{
				i++;
				if (i < n && (text[i] == '-' || text[i] == '+'))
					i++;
				i32 exponent = 0;
				loop (i < n && text[i] >= '0' && text[i] <= '9')
				{
					i++;
					exponent++;
				}
				if (exponent == 0)
					return false;
			}
			return i == n;
		}

		public:
			/// As text by a format: F, N, E, P, G, R and a precision (`(2.5).ToString("F2")` is "2.50").
			ToString(str format) : str => NumberFormat.FormatDouble(this, format);

			/// The number as `print` writes it (up to 15 significant digits).
			ToString() : str
			{
				i64 count = FormatInto(this);
				u8[] digits = new u8[(i32)count];
				loop (i32 i = 0..digits.Length)
					digits[i] = (u8)FormattedUnit(i);
				return new String<u8>(digits);
			}

			CompareTo(f64 other) : i32 => this < other ? -1 : this > other ? 1 : 0;
			Equals(f64 other) : bool => this == other || IsNaN(this) && IsNaN(other);
			Hash() : u64 => (u64)BitsOf(this == 0 ? 0 : this);

			/// The IEEE 754 bits of the number, and back.
			static Bits(f64 value) : i64 => BitsOf(value);

			static FromBits(i64 bits) : f64 => FromBitsOf(bits);

			static IsNaN(f64 x) : bool => x != x;
			static IsInfinity(f64 x) : bool => x - x != 0 && x == x;
			static IsFinite(f64 x) : bool => x - x == 0;

			/// The number `text` writes (digits, a point, an exponent); a FormatError otherwise.
			static Parse(str text) : f64
			{
				str trimmed = text.Trim();
				if (trimmed == "NaN")
					return NaN;
				if (trimmed == "Infinity" || trimmed == "+Infinity")
					return PositiveInfinity;
				if (trimmed == "-Infinity")
					return NegativeInfinity;
				if (!IsNumber(trimmed.Units()))
					throw new FormatError("not a number: " + text);
				return FromBitsOf(ParseBits(Unicode.ToUtf16(trimmed)));
			}

			/// The number `text` writes, or null when it writes none.
			static TryParse(str text) : f64?
			{
				str trimmed = text.Trim();
				if (trimmed == "NaN" || trimmed == "Infinity" || trimmed == "+Infinity" || trimmed == "-Infinity")
					return Parse(trimmed);
				if (!IsNumber(trimmed.Units()))
					return null;
				return FromBitsOf(ParseBits(Unicode.ToUtf16(trimmed)));
			}
	}

	[Primitive("f32")]
	public value Float32 : ISignedNumber<f32>, IComparable<f32>, IToString
	{
		public:
			static f32 Zero { get => 0.0; }
			static f32 One { get => 1.0; }
			/// The largest finite f32, and the smallest (its negative).
			const f32 MaxValue = 3.4028234663852886e38;
			const f32 MinValue = -3.4028234663852886e38;
			/// The smallest f32 above zero (a subnormal).
			const f32 Epsilon = 1.4012984643248171e-45;
			/// Not a number (quiet, positive), and the infinities.
			const f32 NaN = 0.0 / 0.0;
			const f32 PositiveInfinity = 1.0 / 0.0;
			const f32 NegativeInfinity = -1.0 / 0.0;
			[Inline] static FromF64(f64 value) : f32 => (f32)value;
			[Inline] static ToF64(f32 value) : f64 => (f64)value;
			static f32 NegativeOne { get => -1.0; }

			/// As text by a format: F, N, E, P, G, R and a precision (`(2.5).ToString("F2")` is "2.50").
			ToString(str format) : str => NumberFormat.FormatSingle(this, format);

			ToString() : str => NumberFormat.FormatSingle(this, "R");
			CompareTo(f32 other) : i32 => this < other ? -1 : this > other ? 1 : 0;

			/// The IEEE 754 bits of `value` (an f32 is exact as an f64: its bits are rebuilt from those).
			static Bits(f32 value) : u32
			{
				i64 wide = Float64.Bits(value);
				u32 sign = (u32)(wide >> 32) & 0x80000000;
				i32 exponent = (i32)(wide >> 52) & 0x7FF;
				i64 mantissa = wide & 0xFFFFFFFFFFFFF;
				if (exponent == 0x7FF)
					return sign | 0x7F800000 | (u32)(mantissa >> 29) | (mantissa != 0 ? 0x400000 : 0);
				if (exponent == 0)
					return sign;
				i32 biased = exponent - 1023 + 127;
				if (biased >= 1)
					return sign | (u32)biased << 23 | (u32)(mantissa >> 29);
				// Subnormal: the hidden bit shifted down.
				return sign | (u32)((mantissa | 0x10000000000000) >> (30 - biased));
			}

			/// The f32 with these IEEE 754 bits.
			static FromBits(u32 bits) : f32
			{
				i64 sign = (i64)(bits & 0x80000000) << 32;
				i32 exponent = (i32)(bits >> 23) & 0xFF;
				i64 mantissa = bits & 0x7FFFFF;
				if (exponent == 0xFF)
					return (f32)Float64.FromBits(sign | 0x7FF0000000000000 | mantissa << 29);
				if (exponent == 0)
				{
					if (mantissa == 0)
						return (f32)Float64.FromBits(sign);
					// Subnormal: normalized as an f64.
					i32 shift = 0;
					loop ((mantissa & 0x800000) == 0)
					{
						mantissa = mantissa << 1;
						shift++;
					}
					return (f32)Float64.FromBits(sign | (i64)(1 - 127 - shift + 1023) << 52 | (mantissa & 0x7FFFFF) << 29);
				}
				return (f32)Float64.FromBits(sign | (i64)(exponent - 127 + 1023) << 52 | mantissa << 29);
			}
	}

	[Primitive("f16")]
	public value Float16 : ISignedNumber<f16>, IComparable<f16>, IToString
	{
		public:
			static f16 Zero { get => 0; }
			static f16 One { get => 1; }
			/// The largest finite f16, and the smallest (its negative).
			const f16 MaxValue = 65504.0;
			const f16 MinValue = -65504.0;
			/// The smallest f16 above zero (a subnormal).
			const f16 Epsilon = 5.9604644775390625e-8;
			/// Not a number (quiet, positive), and the infinities.
