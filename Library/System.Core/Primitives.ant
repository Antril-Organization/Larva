	[Primitive("i128")]
	public value Int128 : ISignedNumber<i128>, IHashable<i128>, IComparable<i128>, IToString
	{
		public:
			static i128 Zero { get => 0; }
			static i128 One { get => 1; }
			/// The smallest i128.
			const i128 MinValue = -170141183460469231731687303715884105727 - 1;
			/// The largest i128.
			const i128 MaxValue = 170141183460469231731687303715884105727;
			// Through two 64-bit halves: a conversion of all 128 bits needs a routine not every back end has.
			static FromF64(f64 value) : i128
			{
				if (value < 0)
					return -(i128)UInt128.FromF64(-value);
				return (i128)UInt128.FromF64(value);
			}
			static ToF64(i128 value) : f64 => value < 0 ? -UInt128.ToF64((u128)(-value)) : UInt128.ToF64((u128)value);
			static i128 NegativeOne { get => -1; }

			ToString() : str
			{
				if (this >= 0)
					return Number.FormatUnsigned((u128)this);
				// -(value + 1) + 1 keeps the smallest value in range.
				u128 magnitude = (u128)(-(this + 1)) + 1;
				return "-" + Number.FormatUnsigned(magnitude);
			}
			Hash() : u64 => (u64)this ^ (u64)(this >> 64);
			Equals(i128 other) : bool => this == other;
			CompareTo(i128 other) : i32 => this < other ? -1 : this > other ? 1 : 0;

			/// The integer `text` writes (an optional '-', then decimal digits); a FormatError otherwise.
			static Parse(str text) : i128
			{
				i128? value = TryParse(text);
				if (value == null)
					throw new FormatError("not a number: " + text);
				return value.Value;
			}

			/// The number `text` writes, or null when it writes none.
			static TryParse(str text) : i128?
			{
				i32 length = text.Length;
				bool negative = length > 0 && text[0] == 45;
				i32 start = negative ? 1 : 0;
				if (start == length)
					return null;
				i128 value = 0;
				loop (i32 i = start..length)
				{
					u8 unit = text[i];
					if (unit < 48 || unit > 57)
						return null;
					value = value * 10 + (i128)(unit - 48);
				}
				return negative ? -value : value;
			}
	}

	[Primitive("u128")]
	public value UInt128 : INumber<u128>, IHashable<u128>, IComparable<u128>, IToString
	{
		public:
			static u128 Zero { get => 0; }
			static u128 One { get => 1; }
			/// The smallest u128.
			const u128 MinValue = 0;
			/// The largest u128.
			const u128 MaxValue = 340282366920938463463374607431768211455;
			// Through two 64-bit halves: a conversion of all 128 bits needs a routine not every back end has.
			static FromF64(f64 value) : u128
			{
				f64 half = 18446744073709551616.0; // 2^64
				if (value < half)
					return (u128)(u64)value;
				f64 high = Math.Floor(value / half);
				return ((u128)(u64)high << 64) + (u128)(u64)(value - high * half);
			}
			static ToF64(u128 value) : f64 => (f64)(u64)(value >> 64) * 18446744073709551616.0 + (f64)(u64)value;

			ToString() : str => Number.FormatUnsigned(this);
			Hash() : u64 => (u64)this ^ (u64)(this >> 64);
			Equals(u128 other) : bool => this == other;
			CompareTo(u128 other) : i32 => this < other ? -1 : this > other ? 1 : 0;

			/// The integer `text` writes (decimal digits); a FormatError otherwise.
			static Parse(str text) : u128
			{
				u128? value = TryParse(text);
				if (value == null)
					throw new FormatError("not a number: " + text);
				return value.Value;
			}

			/// The number `text` writes, or null when it writes none.
			static TryParse(str text) : u128?
			{
				i32 length = text.Length;
				i32 start = 0;
				if (start == length)
					return null;
				u128 value = 0;
				loop (i32 i = start..length)
				{
					u8 unit = text[i];
					if (unit < 48 || unit > 57)
						return null;
					value = value * 10 + (u128)(unit - 48);
				}
				return value;
			}
	}

	[Primitive("i256")]
	public value Int256 : ISignedNumber<i256>, IHashable<i256>, IComparable<i256>, IToString
	{
		public:
			static i256 Zero { get => 0; }
			static i256 One { get => 1; }
			/// The smallest i256.
			const i256 MinValue = -57896044618658097711785492504343953926634992332820282019728792003956564819967 - 1;
			/// The largest i256.
			const i256 MaxValue = 57896044618658097711785492504343953926634992332820282019728792003956564819967;
			// Through two 128-bit halves: a conversion of all 256 bits has no routine on every back end.
			static FromF64(f64 value) : i256
			{
				if (value < 0)
					return -(i256)UInt256.FromF64(-value);
				return (i256)UInt256.FromF64(value);
			}
			static ToF64(i256 value) : f64 => value < 0 ? -UInt256.ToF64((u256)(-value)) : UInt256.ToF64((u256)value);
			static i256 NegativeOne { get => -1; }

			ToString() : str
			{
				if (this >= 0)
					return Number.FormatUnsigned((u256)this);
				// -(value + 1) + 1 keeps the smallest value in range.
				u256 magnitude = (u256)(-(this + 1)) + 1;
				return "-" + Number.FormatUnsigned(magnitude);
			}
			Hash() : u64 => (u64)this ^ (u64)(this >> 64) ^ (u64)(this >> 128) ^ (u64)(this >> 192);
			Equals(i256 other) : bool => this == other;
			CompareTo(i256 other) : i32 => this < other ? -1 : this > other ? 1 : 0;

			/// The integer `text` writes (an optional '-', then decimal digits); a FormatError otherwise.
			static Parse(str text) : i256
			{
				i256? value = TryParse(text);
				if (value == null)
					throw new FormatError("not a number: " + text);
				return value.Value;
			}

			/// The number `text` writes, or null when it writes none.
			static TryParse(str text) : i256?
			{
				i32 length = text.Length;
				bool negative = length > 0 && text[0] == 45;
				i32 start = negative ? 1 : 0;
				if (start == length)
					return null;
				i256 value = 0;
				loop (i32 i = start..length)
				{
					u8 unit = text[i];
					if (unit < 48 || unit > 57)
						return null;
					value = value * 10 + (i256)(unit - 48);
				}
				return negative ? -value : value;
			}
	}

	[Primitive("u256")]
	public value UInt256 : INumber<u256>, IHashable<u256>, IComparable<u256>, IToString
	{
		public:
			static u256 Zero { get => 0; }
			static u256 One { get => 1; }
			/// The smallest u256.
			const u256 MinValue = 0;
			/// The largest u256.
			const u256 MaxValue = 115792089237316195423570985008687907853269984665640564039457584007913129639935;
			// Through two 128-bit halves: a conversion of all 256 bits has no routine on every back end.
			static FromF64(f64 value) : u256
			{
				f64 half = 340282366920938463463374607431768211456.0; // 2^128
				if (value < half)
					return (u256)UInt128.FromF64(value);
				f64 high = Math.Floor(value / half);
				return ((u256)UInt128.FromF64(high) << 128) + (u256)UInt128.FromF64(value - high * half);
			}
			static ToF64(u256 value) : f64 => UInt128.ToF64((u128)(value >> 128)) * 340282366920938463463374607431768211456.0 + UInt128.ToF64((u128)value);

			ToString() : str => Number.FormatUnsigned(this);
			Hash() : u64 => (u64)this ^ (u64)(this >> 64) ^ (u64)(this >> 128) ^ (u64)(this >> 192);
			Equals(u256 other) : bool => this == other;
			CompareTo(u256 other) : i32 => this < other ? -1 : this > other ? 1 : 0;

			/// The integer `text` writes (decimal digits); a FormatError otherwise.
			static Parse(str text) : u256
			{
				u256? value = TryParse(text);
				if (value == null)
					throw new FormatError("not a number: " + text);
				return value.Value;
			}

			/// The number `text` writes, or null when it writes none.
			static TryParse(str text) : u256?
			{
				i32 length = text.Length;
				i32 start = 0;
				if (start == length)
					return null;
				u256 value = 0;
				loop (i32 i = start..length)
				{
					u8 unit = text[i];
					if (unit < 48 || unit > 57)
						return null;
					value = value * 10 + (u256)(unit - 48);
				}
				return value;
			}
	}

	[Primitive("f128")]
	public value Float128 : ISignedNumber<f128>, IHashable<f128>, IComparable<f128>, IToString
	{
		public:
			static f128 Zero { get => 0; }
			static f128 One { get => 1; }
			/// The largest finite f128, and the smallest (its negative).
			const f128 MaxValue = 1.189731495357231765085759326628007016196e4932f128;
			const f128 MinValue = -1.189731495357231765085759326628007016196e4932f128;
			/// The smallest f128 above zero (a subnormal).
			const f128 Epsilon = 6.475175119438025110924438958227646552500e-4966f128;
			/// Not a number (quiet, positive), and the infinities.
			const f128 NaN = 0.0f128 / 0.0f128;
			const f128 PositiveInfinity = 1.0f128 / 0.0f128;
			const f128 NegativeInfinity = -1.0f128 / 0.0f128;
			[Inline] static FromF64(f64 value) : f128 => (f128)value;
			[Inline] static ToF64(f128 value) : f64 => (f64)value;
			static f128 NegativeOne { get => -1; }

			/// As text by a format: F, N, E, P, G, R and a precision; the fixed formats show up to 33 digits.
			ToString(str format) : str => NumberFormat.FormatWide(Bits(this), 128, format);

			/// The shortest text that reads back as the same number.
			ToString() : str => NumberFormat.FormatWide(Bits(this), 128, "G");
			CompareTo(f128 other) : i32 => this < other ? -1 : this > other ? 1 : 0;
			Equals(f128 other) : bool => this == other || IsNaN(this) && IsNaN(other);

			Hash() : u64
			{
				u128 bits = Bits(this == 0 ? 0 : this);
				return (u64)bits ^ (u64)(bits >> 64);
			}

			/// The IEEE 754 bits of the number, and back.
			static unsafe Bits(f128 value) : u128
			{
				f128 local = value;
				return *(u128*)&local;
			}

			static unsafe FromBits(u128 bits) : f128
			{
				u128 local = bits;
				return *(f128*)&local;
			}

			static IsNaN(f128 x) : bool => x != x;
			static IsInfinity(f128 x) : bool => x - x != 0 && x == x;
			static IsFinite(f128 x) : bool => x - x == 0;

			/// The number `text` writes (digits, a point, an exponent); a FormatError otherwise.
			static Parse(str text) : f128
			{
				str trimmed = text.Trim();
				if (trimmed == "NaN")
					return NaN;
				if (trimmed == "Infinity" || trimmed == "+Infinity")
					return PositiveInfinity;
				if (trimmed == "-Infinity")
					return NegativeInfinity;
				if (!Float64.IsNumber(trimmed.Units()))
					throw new FormatError("not a number: " + text);
				return Read(trimmed.Units());
			}

			/// The number `text` writes, or null when it writes none.
			static TryParse(str text) : f128?
			{
				str trimmed = text.Trim();
				if (trimmed == "NaN" || trimmed == "Infinity" || trimmed == "+Infinity" || trimmed == "-Infinity")
					return Parse(trimmed);
				if (!Float64.IsNumber(trimmed.Units()))
					return null;
				return Read(trimmed.Units());
			}

		/// Digits × 10^exponent: exact (one correctly rounded operation) up to 33 significant digits and a power
		/// of ten up to 10^48, which the type holds exactly; beyond that, within a few units in the last place.
		static Read(u8[] units) : f128
		{
			i32 i = 0;
			bool negative = units[0] == '-';
			if (negative || units[0] == '+')
				i++;
			u128 digits = 0;
			i32 count = 0;
			i32 exponent = 0;
			bool afterPoint = false;
			loop (i < units.Length)
			{
				u8 c = units[i];
				i++;
				if (c == '.')
				{
					afterPoint = true;
					continue;
				}
				if (c == 'e' || c == 'E')
				{
					bool negativeExponent = units[i] == '-';
					if (negativeExponent || units[i] == '+')
						i++;
					i32 e = 0;
					loop (i < units.Length)
					{
						if (e < 1000000)
							e = e * 10 + (i32)(units[i] - 48);
						i++;
					}
					exponent += negativeExponent ? -e : e;
					break;
				}
				i32 d = (i32)(c - 48);
				if (digits == 0 && d == 0)
				{
					if (afterPoint)
						exponent--;
					continue;
				}
				if (count < 33)
				{
					digits = digits * 10 + (u128)d;
					count++;
					if (afterPoint)
						exponent--;
				}
				else if (!afterPoint)
				{
					exponent++;
				}
			}
			f128 value = (f128)digits;
			loop (exponent > 0)
			{
				i32 step = exponent > 4000 ? 4000 : exponent;
				value = value * PowerOfTen(step);
				exponent -= step;
			}
			loop (exponent < 0)
			{
				i32 step = -exponent > 4000 ? 4000 : -exponent;
				value = value / PowerOfTen(step);
				exponent += step;
			}
			return negative ? -value : value;
		}

		/// 10^power by squaring (exact up to 10^48).
		static PowerOfTen(i32 power) : f128
		{
			f128 result = 1;
			f128 base = 10;
			loop (power > 0)
			{
				if ((power & 1) != 0)
					result = result * base;
				base = base * base;
				power = power >> 1;
			}
			return result;
		}
	}

	[Primitive("f256")]
	public value Float256 : ISignedNumber<f256>, IHashable<f256>, IComparable<f256>, IToString
	{
		public:
			static f256 Zero { get => 0; }
			static f256 One { get => 1; }
			/// The largest finite f256, and the smallest (its negative).
			const f256 MaxValue = 1.61132571748576047361957211845200501064402387454966951747637125049607182699e78913f256;
			const f256 MinValue = -1.61132571748576047361957211845200501064402387454966951747637125049607182699e78913f256;
			/// The smallest f256 above zero (a subnormal).
			const f256 Epsilon = 2.24800708647703657297018614776265182597360918266100276294348974547709294462e-78984f256;
			/// Not a number (quiet, positive), and the infinities.
			const f256 NaN = 0.0f256 / 0.0f256;
