// Tuples: `(i32, str)` is ValueTuple<i32, str>, and `(1, "a")` makes one. ValueTuple is a value whose items can be
// changed; Tuple is a class whose items are fixed once it is made. Both hold their items as Item1, Item2… and are
// records: `==` compares the items, `with` copies one with some replaced, `t is (var a, var b)` takes them in order,
// ToString() shows `(1, a)`, and Equals/Hash() make them keys of a Dictionary. 1 to 16 items are written out below;
// more come from the variadic ValueTuple<TArgs...> and Tuple<TArgs...> at the end, made for the sizes a program uses.

into namespace System
{
	/// 1 item in a value: Item1, which can be changed.
	public record value ValueTuple<T1>
	{
		public:
			T1 Item1;

			new(T1 Item1);

			/// The same items in a Tuple (a class).
			ToTuple() : Tuple<T1> => new Tuple<T1>(Item1);
	}

	/// 1 item in an object: Item1, fixed when it is made.
	public record class Tuple<T1>
	{
		public:
			readonly T1 Item1;

			new(T1 Item1);

			/// The same items in a ValueTuple.
			ToValueTuple() : ValueTuple<T1> => new ValueTuple<T1>(Item1);
	}

	/// 2 items in a value: Item1…Item2, which can be changed.
	public record value ValueTuple<T1, T2>
	{
		public:
			T1 Item1;
			T2 Item2;

			new(T1 Item1, T2 Item2);

			/// The same items in a Tuple (a class).
			ToTuple() : Tuple<T1, T2> => new Tuple<T1, T2>(Item1, Item2);
	}

	/// 2 items in an object: Item1…Item2, fixed when it is made.
	public record class Tuple<T1, T2>
