// JSON: a value read from text (JsonValue.Parse) or built by hand, and written back (ToString, compact). Objects keep
// their members in order. Numbers are f64 (an integer prints without a fraction; nan and the infinities are no JSON:
// writing one is a FormatError). Text is UTF-8 in and out; `\uXXXX` escapes (surrogate pairs included) become the
// character's bytes, a lone surrogate U+FFFD. Nesting is limited to JsonReader.MaxDepth (256).

into namespace System.Text
{
	public enum JsonKind { Null, Bool, Number, String, Array, Object }

	public final class JsonValue
	{
		JsonKind kind;
		bool boolean;
		f64 number;
		str text;
		// An array's items, or an object's member values (made when the first one comes).
		List<JsonValue>? items;
		// An object's keys, in order, and from IndexFrom members on, where each one is.
		List<str>? keys;
		Dictionary<str, i32>? index;

		/// Objects up to this many members find a key by looking at each one; bigger ones keep an index.
		const i32 IndexFrom = 8;

		new(JsonKind kind)
		{
			this.kind = kind;
			text = "";
		}

		Expect(JsonKind wanted, str what)
		{
			if (kind != wanted)
				throw new FormatError("the JSON value is not " + what);
		}

		Items() : List<JsonValue>
		{
			if (items is List<JsonValue> list)
				return list;
			List<JsonValue> made = new List<JsonValue>();
			items = made;
			return made;
		}

		Keys() : List<str>
		{
			if (keys is List<str> list)
				return list;
			List<str> made = new List<str>();
			keys = made;
			return made;
		}

		/// Where an object's member `key` is, or -1.
		Find(str key) : i32
		{
			if (index is Dictionary<str, i32> map)
				return map.TryGet(key, -1);
			if (keys is List<str> list)
			{
				i32 count = list.Count;
				if (count < IndexFrom)
				{
					loop (i32 i = 0..count)
					{
						if (list[i] == key)
							return i;
					}
					return -1;
				}
				Dictionary<str, i32> made = new Dictionary<str, i32>();
				loop (i32 i = 0..count)
					made.Set(list[i], i);
				index = made;
				return made.TryGet(key, -1);
			}
			return -1;
		}

		/// `value` in quotes, escaped: the units that need no escape go in as runs.
		static WriteText(StringBuilder sb, str value)
		{
			sb.Append((u16)'"');
			i32 n = value.Length;
			i32 run = 0;
			loop (i32 i = 0..n)
			{
				u32 c = value[i];
				if (c >= 32 && c != '"' && c != '\\')
					continue;
				if (i > run)
					sb.Append(value, run, i - run);
				run = i + 1;
				if (c == '"')
					sb.Append("\\\"");
				else if (c == '\\')
					sb.Append("\\\\");
				else if (c == 10)
					sb.Append("\\n");
				else if (c == 13)
					sb.Append("\\r");
				else if (c == 9)
					sb.Append("\\t");
				else if (c == 8)
					sb.Append("\\b");
				else if (c == 12)
					sb.Append("\\f");
				else
				{
					sb.Append("\\u00");
					sb.Append(Hex(c >> 4));
					sb.Append(Hex(c & 15));
				}
			}
			if (n > run)
				sb.Append(value, run, n - run);
			sb.Append((u16)'"');
		}

		static Hex(u32 digit) : u16 => (u16)(digit < 10 ? '0' + digit : 'a' + digit - 10);

		Write(StringBuilder sb)
		{
			if (kind == JsonKind.Null)
				sb.Append("null");
			else if (kind == JsonKind.Bool)
				sb.Append(boolean ? "true" : "false");
			else if (kind == JsonKind.Number)
			{
				if (number - number != 0)
					throw new FormatError("JSON has no value for " + number.ToString());
				i64 whole = (i64)number;
				if ((f64)whole == number && number > -9007199254740992.0 && number < 9007199254740992.0)
					sb.Append(whole);
				else
					sb.Append(number.ToString());
			}
			else if (kind == JsonKind.String)
				WriteText(sb, text);
			else if (kind == JsonKind.Array)
			{
				sb.Append((u16)'[');
				if (items is List<JsonValue> list)
				{
					loop (i32 i = 0..list.Count)
					{
						if (i > 0)
							sb.Append((u16)',');
						list[i].Write(sb);
					}
				}
				sb.Append((u16)']');
			}
			else
			{
				sb.Append((u16)'{');
				if (keys is List<str> names && items is List<JsonValue> values)
				{
					loop (i32 i = 0..names.Count)
					{
						if (i > 0)
							sb.Append((u16)',');
						WriteText(sb, names[i]);
						sb.Append((u16)':');
						values[i].Write(sb);
					}
				}
				sb.Append((u16)'}');
			}
		}

		public:
			JsonKind Kind { get => kind; }
			bool IsNull { get => kind == JsonKind.Null; }

			static Null() : JsonValue => new JsonValue(JsonKind.Null);

			static Of(bool value) : JsonValue
			{
				JsonValue v = new JsonValue(JsonKind.Bool);
				v.boolean = value;
				return v;
			}

			static Of(f64 value) : JsonValue
			{
				JsonValue v = new JsonValue(JsonKind.Number);
				v.number = value;
				return v;
			}

			static Of(i32 value) : JsonValue => Of((f64)value);

			static Of(str value) : JsonValue
			{
				JsonValue v = new JsonValue(JsonKind.String);
				v.text = value;
				return v;
			}

			static NewArray() : JsonValue => new JsonValue(JsonKind.Array);

			static NewObject() : JsonValue => new JsonValue(JsonKind.Object);

			bool AsBool { get { Expect(JsonKind.Bool, "a bool"); return boolean; } }
			f64 AsNumber { get { Expect(JsonKind.Number, "a number"); return number; } }
			str AsString { get { Expect(JsonKind.String, "a string"); return text; } }

			/// Items of an array, or members of an obj.
			i32 Count
			{
				get
				{
					if (kind == JsonKind.Array || kind == JsonKind.Object)
					{
						if (items is List<JsonValue> list)
							return list.Count;
					}
					return 0;
				}
			}

			/// An array's item.
			At(i32 index) : JsonValue
			{
				Expect(JsonKind.Array, "an array");
				return Items()[index];
			}

			/// Appends to an array (returns this, to chain).
			Add(JsonValue item) : JsonValue
			{
				Expect(JsonKind.Array, "an array");
				Items().Add(item);
				return this;
			}

			/// The key of the i-th member of an obj.
			KeyAt(i32 index) : str
			{
				Expect(JsonKind.Object, "an obj");
				return Keys()[index];
			}

			/// The i-th member's value.
			ValueAt(i32 index) : JsonValue
			{
				Expect(JsonKind.Object, "an obj");
				return Items()[index];
			}

			Has(str key) : bool => kind == JsonKind.Object && Find(key) >= 0;

			/// An obj's member, or null when there is none.
			Get(str key) : JsonValue?
			{
				if (kind != JsonKind.Object)
					return null;
				i32 at = Find(key);
				if (at < 0)
					return null;
				return Items()[at];
			}

			/// Sets an obj's member (replacing one with that key; returns this, to chain).
			Set(str key, JsonValue value) : JsonValue
			{
				Expect(JsonKind.Object, "an obj");
				i32 at = Find(key);
				List<JsonValue> values = Items();
				if (at >= 0)
				{
					values[at] = value;
					return this;
				}
				List<str> names = Keys();
				names.Add(key);
				values.Add(value);
				if (index is Dictionary<str, i32> map)
					map.Set(key, names.Count - 1);
				return this;
			}

			/// The value as JSON text (compact).
			override ToString() : str
			{
				StringBuilder sb = new StringBuilder();
				Write(sb);
				return sb.ToString();
			}

			static Parse(str json) : JsonValue
			{
				JsonReader reader = new JsonReader(json.Units());
				JsonValue value = reader.ReadValue();
				reader.SkipSpace();
				if (!reader.AtEnd)
					reader.Fail("text after the value");
				return value;
			}
	}

	/// Reads a value from UTF-8 units. Arrays and objects nest at most MaxDepth deep (a FormatError beyond).
	public final class JsonReader
	{
		u8[] p;
		i32 at;
		i32 depth;
		// The units of a string with escapes, as they are read (reused from one string to the next).
		u8[] scratch;
		i32 used;
		// The keys read last, by a hash of their units: objects of one shape share their keys' strings.
		str?[] keys;

		Enter()
		{
			depth++;
			if (depth > MaxDepth)
				Fail("nesting deeper than " + MaxDepth);
		}

		Put(u32 unit)
		{
			if (used == scratch.Length)
			{
				u8[] bigger = new u8[scratch.Length * 2];
				Array.Copy(scratch, 0, bigger, 0, used);
				scratch = bigger;
			}
			scratch[used] = (u8)unit;
			used++;
		}

		public:
			const i32 MaxDepth = 256; // deep enough for any sane document, shallow enough for a 1 MB stack with reference counting

			new(u8[] units)
			{
				p = units;
				scratch = new u8[64];
				keys = new str?[64];
			}

			bool AtEnd { get => at >= p.Length; }

			Fail(str what)
			{
				throw new FormatError("JSON: " + what + " at " + at);
			}

			SkipSpace()
			{
				loop (at < p.Length && (p[at] == 32 || p[at] == 9 || p[at] == 10 || p[at] == 13))
					at++;
			}

			ReadValue() : JsonValue
			{
				SkipSpace();
				if (at >= p.Length)
					Fail("unexpected end");
				u32 c = p[at];
				if (c == '{')
					return ReadObject();
				if (c == '[')
					return ReadArray();
				if (c == '"')
					return JsonValue.Of(ReadText());
				if (c == 't')
				{
					ExpectWord("true");
					return JsonValue.Of(true);
				}
				if (c == 'f')
				{
					ExpectWord("false");
					return JsonValue.Of(false);
				}
				if (c == 'n')
				{
					ExpectWord("null");
					return JsonValue.Null();
				}
				if (c == '-' || (c >= '0' && c <= '9'))
					return ReadNumber();
				Fail("unexpected character");
				return JsonValue.Null();
			}

			ExpectWord(str word)
			{
				i32 n = word.Length;
				loop (i32 i = 0..n)
				{
					if (at + i >= p.Length || p[at + i] != word[i])
						Fail("expected " + word);
				}
				at += n;
			}

			/// A number by the JSON grammar: `-`?, `0` or digits not starting with one, a fraction `.` digits, an
			/// exponent `e`/`E`, a sign, digits (no leading zeros, no `1.`, no `.5`).
			ReadNumber() : JsonValue
			{
				i32 start = at;
				bool negative = p[at] == '-';
				if (negative)
					at++;
				if (at < p.Length && p[at] == '0')
					at++;
				else if (Digits() == 0)
					Fail("bad number");
				// An integer of up to 15 digits is exact in an f64: no text to parse (-0 keeps its sign through it).
				i32 whole = at - start - (negative ? 1 : 0);
				bool integer = !(at < p.Length && (p[at] == '.' || p[at] == 'e' || p[at] == 'E'));
				if (integer && whole <= 15 && !(negative && whole == 1 && p[at - 1] == '0'))
				{
					i64 value = 0;
					loop (i32 i = at - whole..at)
						value = value * 10 + (i64)(p[i] - '0');
					return JsonValue.Of((f64)(negative ? -value : value));
				}
				if (at < p.Length && p[at] == '.')
				{
					at++;
					if (Digits() == 0)
						Fail("bad number");
				}
				if (at < p.Length && (p[at] == 'e' || p[at] == 'E'))
				{
					at++;
					if (at < p.Length && (p[at] == '+' || p[at] == '-'))
						at++;
					if (Digits() == 0)
						Fail("bad number");
				}
				f64? parsed = Float64.TryParse(new String<u8>(p, start, at - start));
				if (parsed == null)
					Fail("bad number");
				return JsonValue.Of(parsed ?? 0.0);
			}

			/// Past the digits here; how many there were.
			Digits() : i32
			{
				i32 start = at;
				loop (at < p.Length && p[at] >= '0' && p[at] <= '9')
					at++;
				return at - start;
			}

			ReadText() : str
			{
				at++;
				// Most strings have no escape: they are a part of the text as it is.
				i32 start = at;
				loop (at < p.Length && p[at] != '"' && p[at] != '\\')
					at++;
				if (at >= p.Length)
					Fail("unterminated string");
				if (p[at] == '"')
				{
					at++;
					return new String<u8>(p, start, at - 1 - start);
				}
				used = 0;
				loop (i32 i = start..at)
					Put(p[i]);
				loop (true)
				{
					if (at >= p.Length)
						Fail("unterminated string");
					u32 c = p[at];
					at++;
					if (c == '"')
						break;
					if (c != '\\')
					{
						Put(c);
						continue;
					}
					if (at >= p.Length)
						Fail("unterminated escape");
					u32 e = p[at];
					at++;
					if (e == 'n')
						Put(10);
					else if (e == 't')
						Put(9);
					else if (e == 'r')
						Put(13);
					else if (e == 'b')
						Put(8);
					else if (e == 'f')
						Put(12);
					else if (e == '"' || e == '\\' || e == '/')
						Put(e);
					else if (e == 'u')
					{
						// A surrogate pair makes one character; a surrogate on its own (or a high one whose next escape
						// is not a low one) becomes U+FFFD and consumes only its own escape.
						u32 code = ReadHex4();
						if (code >= 0xD800 && code < 0xDC00)
						{
							i32 before = at;
							u32 low = 0;
							if (at + 1 < p.Length && p[at] == '\\' && p[at + 1] == 'u')
							{
								at += 2;
								low = ReadHex4();
							}
							if (low >= 0xDC00 && low < 0xE000)
								code = 0x10000 + ((code - 0xD800) << 10) + (low - 0xDC00);
							else
							{
								at = before;
								code = 0xFFFD;
							}
						}
						else if (code >= 0xDC00 && code < 0xE000)
							code = 0xFFFD;
						// The character's UTF-8 bytes.
						if (code < 0x80)
							Put(code);
						else if (code < 0x800)
						{
							Put(0xC0 | code >> 6);
							Put(0x80 | code & 0x3F);
						}
						else if (code < 0x10000)
						{
							Put(0xE0 | code >> 12);
							Put(0x80 | code >> 6 & 0x3F);
							Put(0x80 | code & 0x3F);
						}
						else
						{
							Put(0xF0 | code >> 18);
							Put(0x80 | code >> 12 & 0x3F);
							Put(0x80 | code >> 6 & 0x3F);
							Put(0x80 | code & 0x3F);
						}
					}
					else
						Fail("bad escape");
				}
				return new String<u8>(scratch, 0, used);
			}

			/// An object's key: the string of an earlier key with the same units when there is one.
			ReadKey() : str
			{
				i32 start = at + 1;
				i32 end = start;
				u32 h = 0;
				loop (end < p.Length && p[end] != '"' && p[end] != '\\')
				{
					h = h * 31 + p[end];
					end++;
				}
				if (end >= p.Length || p[end] != '"' || end - start > 32)
					return ReadText();
				i32 count = end - start;
				i32 slot = (i32)(h & 63);
				at = end + 1;
				if (keys[slot] is str known && known.Length == count)
				{
					bool same = true;
					loop (i32 i = 0..count)
					{
						if (known[i] != p[start + i])
						{
							same = false;
							break;
						}
					}
					if (same)
						return known;
				}
				str key = new String<u8>(p, start, count);
				keys[slot] = key;
				return key;
			}

			ReadHex4() : u32
			{
				u32 value = 0;
				loop (i32 i = 0..4)
				{
					if (at >= p.Length)
						Fail("bad \\u escape");
					u32 c = p[at];
					at++;
					u32 digit = c >= '0' && c <= '9' ? c - '0' : c >= 'a' && c <= 'f' ? c - 'a' + 10 : c >= 'A' && c <= 'F' ? c - 'A' + 10 : 16;
					if (digit > 15)
						Fail("bad \\u escape");
					value = value * 16 + digit;
				}
				return value;
			}

			ReadArray() : JsonValue
			{
				at++;
				Enter();
				JsonValue array = JsonValue.NewArray();
				SkipSpace();
				if (at < p.Length && p[at] == ']')
				{
					at++;
					depth--;
					return array;
				}
				loop (true)
				{
					array.Add(ReadValue());
					SkipSpace();
					if (at >= p.Length)
						Fail("unterminated array");
					u32 c = p[at];
					at++;
					if (c == ']')
						break;
					if (c != ',')
						Fail("expected , or ]");
				}
				depth--;
				return array;
			}

			ReadObject() : JsonValue
			{
				at++;
				Enter();
				JsonValue obj = JsonValue.NewObject();
				SkipSpace();
				if (at < p.Length && p[at] == '}')
				{
					at++;
					depth--;
					return obj;
				}
				loop (true)
				{
					SkipSpace();
					if (at >= p.Length || p[at] != '"')
						Fail("expected a key");
					str key = ReadKey();
					SkipSpace();
					if (at >= p.Length || p[at] != ':')
						Fail("expected :");
					at++;
					obj.Set(key, ReadValue());
					SkipSpace();
					if (at >= p.Length)
						Fail("unterminated obj");
					u32 c = p[at];
					at++;
					if (c == '}')
						break;
					if (c != ',')
						Fail("expected , or }");
				}
				depth--;
				return obj;
			}
	}
}
