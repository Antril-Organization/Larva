// Values as bytes on streams (System.IO): BinaryWriter writes numbers little-endian and str as a 7-bit encoded length
// then its UTF-8 bytes; BinaryReader reads them back (EndOfStreamError when the stream ends in the middle of one).

import System.Text;

into namespace System.IO
{
	public class BinaryWriter
	{
		Stream stream;
		/// The stream when it is a MemoryStream: calls through this type can be direct (the program does not override them).
		MemoryStream? memory;
		u8[] scratch;

		Put(u64 value, i32 count)
		{
			loop (i32 i = 0..count)
			{
				scratch[i] = (u8)value;
				value = value >> 8;
			}
			if (memory is MemoryStream m)
				m.Write(scratch, 0, count);
			else
				stream.Write(scratch, 0, count);
		}

		public:
			new(Stream output)
			{
				if (!output.CanWrite)
					throw new ArgumentError("BinaryWriter: the stream cannot be written");
				stream = output;
				memory = output is MemoryStream m ? m : null;
				scratch = new u8[16];
			}

			/// The stream it writes to.
			Stream BaseStream { get => stream; }

			Write(u8 value) { stream.WriteByte(value); }
			Write(i8 value) { stream.WriteByte((u8)value); }
			Write(bool value) { stream.WriteByte(value ? 1 : 0); }
			Write(i16 value) { Put((u64)value, 2); }
			Write(u16 value) { Put(value, 2); }
			Write(i32 value) { Put((u64)value, 4); }
			Write(u32 value) { Put(value, 4); }
			Write(i64 value) { Put((u64)value, 8); }
			Write(u64 value) { Put(value, 8); }
			Write(f32 value) { Put(Float32.Bits(value), 4); }
			Write(f64 value) { Put((u64)Float64.Bits(value), 8); }

			/// The byte count (7-bit encoded) and the UTF-8 bytes.
			Write(str text)
			{
				u8[] bytes = text.Units();
				Write7BitEncodedInt(bytes.Length);
				stream.Write(bytes, 0, bytes.Length);
			}

			/// The bytes, without their count.
			Write(u8[] bytes) { stream.Write(bytes, 0, bytes.Length); }

			Write(u8[] bytes, i32 offset, i32 count) { stream.Write(bytes, offset, count); }

			/// 7 bits per byte, the high bit set on every byte but the last.
			Write7BitEncodedInt(i32 value)
			{
				u32 rest = (u32)value;
				i32 count = 0;
				loop (rest >= 0x80)
				{
					scratch[count] = (u8)(rest | 0x80);
					rest = rest >> 7;
					count++;
				}
				scratch[count] = (u8)rest;
				stream.Write(scratch, 0, count + 1);
			}

			Flush() { stream.Flush(); }

			Close() { stream.Close(); }
	}

	public class BinaryReader
	{
		Stream stream;
		/// The stream when it is a MemoryStream (see BinaryWriter).
		MemoryStream? memory;
		u8[] scratch;

		/// The rest of a value the stream gave only in part (the rare path, kept out of Take so Take inlines).
		[NoInline]
		Rest(i32 got, i32 count) { stream.ReadExactly(scratch, got, count - got); }

		Take(i32 count) : u64
		{
			i32 got = memory is MemoryStream m ? m.Read(scratch, 0, count) : stream.Read(scratch, 0, count);
			if (got != count)
				Rest(got, count);
			u64 value = 0;
			i32 i = count - 1;
			loop (i >= 0)
			{
				value = value << 8 | scratch[i];
				i--;
			}
			return value;
		}

		public:
			new(Stream input)
			{
				if (!input.CanRead)
					throw new ArgumentError("BinaryReader: the stream cannot be read");
				stream = input;
				memory = input is MemoryStream m ? m : null;
				scratch = new u8[16];
			}

			/// The stream it reads from.
			Stream BaseStream { get => stream; }

			ReadByte() : u8
			{
				i32 b = stream.ReadByte();
				if (b < 0)
					throw new EndOfStreamError();
				return (u8)b;
			}

			ReadSByte() : i8 => (i8)ReadByte();
			ReadBoolean() : bool => ReadByte() != 0;
			ReadInt16() : i16 => (i16)Take(2);
			ReadUInt16() : u16 => (u16)Take(2);
			ReadInt32() : i32 => (i32)Take(4);
			ReadUInt32() : u32 => (u32)Take(4);
			ReadInt64() : i64 => (i64)Take(8);
			ReadUInt64() : u64 => Take(8);
			ReadFloat32() : f32 => Float32.FromBits((u32)Take(4));
			ReadFloat64() : f64 => Float64.FromBits((i64)Take(8));

			/// What Write(str) wrote: a 7-bit encoded byte count and UTF-8 bytes.
			ReadString() : str
			{
				i32 count = Read7BitEncodedInt();
				if (count < 0)
					throw new IOError("BinaryReader.ReadString: a negative length");
				u8[] bytes = new u8[count];
				stream.ReadExactly(bytes, 0, count);
				return Encoding.UTF8.GetString(bytes);
			}

			/// Up to `count` bytes (fewer only at the end of the stream).
			ReadBytes(i32 count) : u8[]
			{
				u8[] bytes = new u8[count];
				i32 got = 0;
				loop (got < count)
				{
					i32 read = stream.Read(bytes, got, count - got);
					if (read == 0)
						return Array.Resize(bytes, got);
					got += read;
				}
				return bytes;
			}

			Read7BitEncodedInt() : i32
			{
				u32 value = 0;
				i32 shift = 0;
				loop (shift < 35)
				{
					u32 b = ReadByte();
					value = value | (b & 0x7F) << shift;
					if (b < 0x80)
						return (i32)value;
					shift += 7;
				}
				throw new IOError("BinaryReader: a 7-bit encoded number is too long");
			}

			Close() { stream.Close(); }
	}
}
