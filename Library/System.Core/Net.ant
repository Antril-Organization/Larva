// TCP over the runtime's stream handles: a connection is a NetworkStream (reads block until bytes arrive; 0 when the
// other end closes), a TcpListener accepts connections, and HttpClient does the smallest useful HTTP: a GET over a fresh
// connection, HTTP/1.0 style (the server closes when the body is done, or says its Content-Length).

import System.IO;

into namespace System.Net
{
	/// The bytes of a connection, by the runtime's handle.
	public final class NetworkStream : HandleStream
	{
		public:
			new(i64 handle) : base(handle, "socket", true, true) { }
	}

	/// One TCP connection.
	public final class TcpClient
	{
		extern("net.connect") ConnectTo(u16[] host, i64 port) : i64;

		NetworkStream stream;

		public:
			new(i64 handle)
			{
				stream = new NetworkStream(handle);
			}

			/// Connects to `host` (a name or an address) at `port`.
			static Connect(str host, i32 port) : TcpClient
			{
				i64 handle = ConnectTo(Unicode.ToUtf16(host), port);
				if (handle < 0)
					throw new IOError("cannot connect to " + host + ":" + port);
				return new TcpClient(handle);
			}

			NetworkStream Stream { get => stream; }

			/// Writes the text's UTF-8 bytes.
			Write(str text)
			{
				u8[] bytes = text.Units();
				stream.Write(bytes, 0, bytes.Length);
			}

			/// Reads what has arrived, up to `max` bytes, as text (empty when the other end closed).
			Read(i32 max) : str
			{
				u8[] buffer = new u8[max];
				i32 n = stream.Read(buffer, 0, max);
				if (n <= 0)
					return "";
				u8[] got = new u8[n];
				Array.Copy(buffer, 0, got, 0, n);
				return new String<u8>(got);
			}

			Close() => stream.Close();
	}

	/// Accepts TCP connections on a port (0: one the system picks; see Port).
	public final class TcpListener
	{
		extern("net.listen") ListenOn(i64 port) : i64;
		extern("net.accept") AcceptOn(i64 listener) : i64;
		extern("net.port") PortOf(i64 handle) : i64;
		extern("stream.close") CloseHandle(i64 handle) : i64;

		i64 handle;

		public:
			new(i32 port)
			{
				handle = ListenOn(port);
				if (handle < 0)
					throw new IOError("cannot listen on port " + port);
			}

			/// The port it listens on.
			i32 Port { get => (i32)PortOf(handle); }

			/// Waits for the next connection.
			Accept() : TcpClient
			{
				i64 connection = AcceptOn(handle);
				if (connection < 0)
					throw new IOError("accept failed");
				return new TcpClient(connection);
			}

			Close()
			{
				if (handle >= 0)
					CloseHandle(handle);
				handle = -1;
			}
	}

	/// What a GET brought back.
	public final class HttpResponse
	{
		public:
			i32 Status;
			str Headers;
			str Body;

			new(i32 status, str headers, str body)
			{
				Status = status;
				Headers = headers;
				Body = body;
			}
	}

	/// The smallest HTTP client: GET over `http://host[:port]/path`, one connection per request, no TLS.
	public static class HttpClient
	{
		public:
			static Get(str url) : HttpResponse
			{
				str rest = url;
				if (rest.StartsWith("http://"))
					rest = rest.Substring(7);
				i32 slash = rest.IndexOf("/");
				str authority = slash < 0 ? rest : rest.Substring(0, slash);
				str path = slash < 0 ? "/" : rest.Substring(slash);
				i32 colon = authority.IndexOf(":");
				str host = colon < 0 ? authority : authority.Substring(0, colon);
				i32 port = colon < 0 ? 80 : Int32.Parse(authority.Substring(colon + 1));
				TcpClient client = TcpClient.Connect(host, port);
				client.Write("GET " + path + " HTTP/1.0\r\nHost: " + authority + "\r\nConnection: close\r\n\r\n");
				StringBuilder received = new StringBuilder();
				loop (true)
				{
					str piece = client.Read(4096);
					if (piece.Length == 0)
						break;
					received.Append(piece);
				}
				client.Close();
				str all = received.ToString();
				i32 split = all.IndexOf("\r\n\r\n");
				str head = split < 0 ? all : all.Substring(0, split);
				str body = split < 0 ? "" : all.Substring(split + 4);
				i32 status = 0;
				i32 space = head.IndexOf(" ");
				if (space >= 0 && head.Length >= space + 4)
					status = Int32.Parse(head.Substring(space + 1, 3));
				return new HttpResponse(status, head, body);
			}
	}
}
