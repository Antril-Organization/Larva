<Project Sdk="Microsoft.NET.Sdk">

  <!-- The larva command line, run as a process: languages from a registry (publish, approve, search, install, update, remove, trust). -->

  <ItemGroup>
    <!-- Built first; the tests run its larva.dll with dotnet. -->
    <ProjectReference Include="..\..\Larva.Cli\Larva.Cli.csproj" ReferenceOutputAssembly="false" />
  </ItemGroup>

  <!-- The Windows setup's registry-free helpers (InstallerTests): the setup is a Windows-only program, so on Windows only. -->
  <ItemGroup Condition="$([MSBuild]::IsOSPlatform('Windows'))">
    <ProjectReference Include="..\..\Larva.Setup\Larva.Setup.csproj" />
  </ItemGroup>
  <ItemGroup Condition="!$([MSBuild]::IsOSPlatform('Windows'))">
    <Compile Remove="InstallerTests.cs" />
  </ItemGroup>

</Project>
